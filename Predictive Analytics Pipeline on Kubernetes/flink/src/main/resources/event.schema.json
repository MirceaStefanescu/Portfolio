{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TelemetryEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType",
    "value",
    "timestamp"
  ],
  "properties": {
    "eventType": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,63}$"
    },
    "value": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "timestamp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800000
    }
  }
}
