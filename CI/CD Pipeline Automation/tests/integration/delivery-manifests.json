      "object": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "labels": {
            "app": "cicd-demo",
            "color": "blue"
          },
          "name": "cicd-demo-blue",
          "namespace": "cicd-demo"
        },
        "spec": {
          "replicas": 2,
          "selector": {
            "matchLabels": {
              "app": "cicd-demo",
              "color": "blue"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "app": "cicd-demo",
                "color": "blue"
              }
            },
            "spec": {
              "containers": [
                {
                  "env": [
                    {
                      "name": "RELEASE_COLOR",
                      "value": "blue"
                    }
                  ],
                  "envFrom": [
                    {
                      "configMapRef": {
                        "name": "cicd-demo-env"
                      }
                    }
                  ],
                  "image": "cicd-demo:local",
                  "imagePullPolicy": "IfNotPresent",
                  "livenessProbe": {
                    "httpGet": {
                      "path": "/health",
                      "port": 8080
                    },
                    "initialDelaySeconds": 10,
                    "periodSeconds": 20
                  },
                  "name": "app",
                  "ports": [
