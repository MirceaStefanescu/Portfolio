{
  "name": "cicd-pipeline-automation",
  "version": "1.0.0",
  "description": "Automated CI/CD pipeline demo for web apps with Jenkins, Docker, Terraform, Ansible, and Kubernetes.",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.test.js\""
  },
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "supertest": "^6.3.4",
    "@eslint/js": "^10.0.1",
    "globals": "^17.13.0"
  },
  "packageManager": "npm@12.2.0"
}
