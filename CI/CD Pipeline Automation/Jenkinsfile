// Set the Pipeline script path to CI/CD Pipeline Automation/Jenkinsfile in the repository.
// A Linux agent needs Node.js 26, Docker/Compose and Bash. Deployment additionally
// needs the tools and explicit target described in README.md.
pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds(); timeout(time: 20, unit: 'MINUTES') }
  parameters {
    choice(name: 'DEPLOY_MODE', choices: ['blue-green', 'rolling', 'canary'], description: 'Deployment strategy')
    choice(name: 'RELEASE_COLOR', choices: ['blue', 'green'], description: 'Blue-green traffic target')
    string(name: 'ENVIRONMENT', defaultValue: 'dev', description: 'Target environment')
    string(name: 'TF_ENV', defaultValue: 'local-kind', description: 'Terraform environment folder')
    string(name: 'IMAGE_REPOSITORY', defaultValue: 'cicd-demo', description: 'Local Docker image repository')
    booleanParam(name: 'AUTO_APPLY', defaultValue: false, description: 'Validate and apply the exact Terraform plan')
    booleanParam(name: 'RUN_ANSIBLE', defaultValue: false, description: 'Configure the selected Kubernetes target')
    booleanParam(name: 'AUTO_DEPLOY', defaultValue: false, description: 'Deploy to the explicitly configured cluster')
  }
  environment {
    IMAGE_NAME = "${params.IMAGE_REPOSITORY}"
    IMAGE_TAG = "${BUILD_NUMBER}"
  }
  stages {
    stage('Build, test and deliver') {
      steps {
        dir('CI/CD Pipeline Automation') {
          withEnv(["RUN_TERRAFORM=${params.AUTO_APPLY}", "RUN_DEPLOY=${params.AUTO_DEPLOY}",
                   "RUN_ANSIBLE=${params.RUN_ANSIBLE}", "GIT_SHA=${env.GIT_COMMIT ?: 'dev'}"]) {
            // Reuse the same checked entrypoint as local CI. The directory is
            // relative to the monorepo checkout, including its spaces.
            sh 'bash scripts/ci.sh'
          }
        }
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'CI/CD Pipeline Automation/deploy/app.env', allowEmptyArchive: true
    }
  }
}
