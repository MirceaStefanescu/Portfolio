{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderCreated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderId",
    "customerId",
    "items",
    "createdAt"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "customerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "quantity"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
