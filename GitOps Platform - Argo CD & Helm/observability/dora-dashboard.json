{
  "uid": "portfolio-dora",
  "title": "Deployment DORA — observed ledger",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "portfolio",
    "dora"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Successful deployments per day",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "portfolio_dora_deployments_per_day",
          "legendFormat": "{{service}} / {{environment}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Mean commit-to-deployment lead time",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "portfolio_dora_lead_time_seconds",
          "legendFormat": "{{service}} / {{environment}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Change failure ratio — releases linked to incidents",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "portfolio_dora_change_failure_ratio",
          "legendFormat": "{{service}} / {{environment}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Mean service restoration time",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "portfolio_dora_restore_time_seconds",
          "legendFormat": "{{service}} / {{environment}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Open incidents",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "portfolio_dora_open_incidents",
          "legendFormat": "{{service}} / {{environment}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Failed deployment attempts",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "portfolio_dora_failed_attempts",
          "legendFormat": "{{service}} / {{environment}}"
        }
      ]
    }
  ]
}
