# Set a random value of at least 32 bytes before starting Compose.
JWT_SECRET=
JWT_ISSUER=portfolio
JWT_AUDIENCE=commerce
RATE_LIMIT_PER_MINUTE=60
# Local-only database defaults are in Compose. Use URL-safe distinct secrets outside local demos.
PRODUCT_DB_PASSWORD=local-products-only
ORDER_DB_PASSWORD=local-orders-only
PAYMENT_DB_PASSWORD=local-payments-only

KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_PRODUCTS=products
KAFKA_TOPIC_ORDERS=orders
KAFKA_TOPIC_PAYMENTS=payments

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
PAYMENT_QUEUE=payment.requests
