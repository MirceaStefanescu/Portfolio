{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "postgres-products-data",
        "namespace": "cloud-native-ecommerce"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "postgres-products",
        "namespace": "cloud-native-ecommerce"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "postgres-products"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "postgres-products"
            }
          },
          "spec": {
            "enableServiceLinks": false,
            "containers": [
              {
                "name": "postgres-products",
                "image": "postgres:15-alpine",
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "products"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "products"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "value": "local-products-only"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "products",
                      "-d",
                      "products"
                    ]
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 5
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "postgres-products-data"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres-products",
        "namespace": "cloud-native-ecommerce"
      },
      "spec": {
        "selector": {
          "app": "postgres-products"
        },
        "ports": [
          {
            "name": "tcp-5432",
            "port": 5432,
            "targetPort": 5432
          }
        ]
      }
    },
