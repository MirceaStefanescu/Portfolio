// Linux agent prerequisites: Docker/Compose, Bash, Python 3.11+ and Conftest 0.71.1.
// The job uses an ephemeral local key and registry; it publishes no external release.
pipeline {
  agent any
  options { timeout(time: 20, unit: 'MINUTES'); disableConcurrentBuilds() }
  parameters {
    string(name: 'REGISTRY_PORT', defaultValue: '5000', description: 'Unused loopback port on the Docker host and agent')
  }
  environment {
    LOCAL_DEMO = '1'
    USE_LOCAL_REGISTRY = '1'
    REGISTRY = "localhost:${params.REGISTRY_PORT}"
    REGISTRY_PORT = "${params.REGISTRY_PORT}"
  }
  stages {
    stage('Verify demonstrative release') {
      steps {
        dir('DevSecOps Pipeline with SBOM & SLSA') {
          sh '''#!/usr/bin/env bash
set -euo pipefail
set +x
export COSIGN_PASSWORD=$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
export COMPOSE_PROJECT_NAME="supply-demo-$(python3 -c 'import uuid; print(uuid.uuid4().hex[:16])')"
export KEYS_DIR="$PWD/.keys/run-${BUILD_NUMBER}"
export SCANNER_CACHE_DIR="$WORKSPACE/.cache/portfolio-security"
trap 'docker compose down --volumes; unset COSIGN_PASSWORD' EXIT
bash scripts/test-pipeline.sh
python3 scripts/test-release-policy.py
conftest verify --policy policy/release --data policy/release/data.json
bash scripts/pipeline.sh dev
python3 scripts/check-demo-artifacts.py --artifacts artifacts --storage storage --backups backups --keys "$KEYS_DIR"
'''
        }
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'DevSecOps Pipeline with SBOM & SLSA/artifacts/*', allowEmptyArchive: true
    }
  }
}
