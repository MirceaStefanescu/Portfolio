REGISTRY=localhost:5000
IMAGE_NAME=devsecops-demo
IMAGE_TAG=dev
USE_LOCAL_REGISTRY=1
# Local key verification, without uploading to a public transparency log.
LOCAL_DEMO=1
APP_DIR=app
ARTIFACTS_DIR=artifacts
STORAGE_DIR=storage
BACKUP_DIR=backups
KEYS_DIR=.keys

POLICY_SEVERITY=HIGH,CRITICAL
POLICY_FAIL_ON=high

TRIVY_IMAGE=aquasec/trivy:0.75.0
GRYPE_IMAGE=anchore/grype:v0.120.1
COSIGN_IMAGE=gcr.io/projectsigstore/cosign:v3.1.3

# Set COSIGN_PASSWORD in the shell; keep the signing password out of this file.
